# ============================================================
# 模拟面试 AI 助手 — 配置模板
# 用法：复制本文件为 .env，填入真实值后即可运行。
# 注意：.env.example 可入库（无密钥）；.env 已 gitignore，切勿提交。
# ============================================================

# ---------- MySQL ----------
# 本地默认：root/123456@127.0.0.1:3306 库 interview（utf8mb4）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_DB=interview

# ---------- Redis ----------
# 本地默认：127.0.0.1:6379 db0，无密码
REDIS_URL=redis://127.0.0.1:6379/0

# ---------- JWT 认证 ----------
# 生产请换成足够长的随机串（可用 openssl rand -hex 32 生成）
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
# token 有效期（小时）
JWT_EXPIRE_HOURS=24

# ---------- 通义千问（DashScope OpenAI 兼容模式） ----------
# API Key 获取：https://dashscope.console.aliyun.com/ → API-KEY 管理
DASHSCOPE_API_KEY=sk-your-dashscope-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 可选 qwen-plus / qwen-turbo / qwen-max 或自定义模型
DASHSCOPE_MODEL=qwen-plus
